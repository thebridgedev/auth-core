{
  "name": "@nebulr-group/bridge-auth-core",
  "version": "0.8.0",
  "description": "The Bridge core client: sign-in flows, sessions and token refresh, feature flags, billing state and the management API for any JavaScript app.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./backend": {
      "types": "./dist/backend/index.d.ts",
      "import": "./dist/backend/index.js",
      "default": "./dist/backend/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "backend": [
        "./dist/backend/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "package": "bun run build && bun pm pack"
  },
  "dependencies": {
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {},
  "repository": {
    "type": "git",
    "url": "https://github.com/thebridgedev/auth-core"
  },
  "license": "MIT",
  "homepage": "https://thebridge.dev/docs/getting-started/",
  "keywords": [
    "typescript",
    "jwt",
    "passkeys",
    "magic-link",
    "management-api",
    "the-bridge",
    "bridge",
    "authentication",
    "auth",
    "login",
    "sso",
    "feature-flags",
    "stripe",
    "subscriptions",
    "billing",
    "plan-limits",
    "multi-tenant",
    "rbac",
    "saas"
  ],
  "bugs": {
    "url": "https://github.com/thebridgedev/auth-core/issues"
  }
}
