{
  "name": "@nebulr-group/bridge-auth-core",
  "version": "1.0.0-alpha.7",
  "description": "The Bridge client core: sign-in in your own pages, sessions with refresh across tabs, workspaces and teams, flag results, billing, live updates, and server-side token checks that honour revocation.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "edge-light": "./dist/server/index.js",
      "workerd": "./dist/server/index.js",
      "worker": "./dist/server/index.js",
      "node": "./dist/server/index.js",
      "browser": "./dist/server/browser.js",
      "import": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./verifier": {
      "types": "./dist/verifier/index.d.ts",
      "browser": "./dist/verifier/index.js",
      "edge-light": "./dist/verifier/index.js",
      "workerd": "./dist/verifier/index.js",
      "worker": "./dist/verifier/index.js",
      "node": "./dist/verifier/index.js",
      "import": "./dist/verifier/index.js",
      "default": "./dist/verifier/index.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n/index.js",
      "default": "./dist/i18n/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "server": [
        "./dist/server/index.d.ts"
      ],
      "verifier": [
        "./dist/verifier/index.d.ts"
      ],
      "i18n": [
        "./dist/i18n/index.d.ts"
      ],
      "testing": [
        "./dist/testing/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "package": "bun run build && bun pm pack"
  },
  "dependencies": {
    "@simplewebauthn/browser": "13.3.0",
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^20.11.0",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thebridgedev/auth-core"
  },
  "license": "MIT",
  "homepage": "https://thebridge.dev/docs/getting-started/",
  "keywords": [
    "the-bridge",
    "bridge",
    "authentication",
    "auth",
    "sign-in",
    "pkce",
    "oauth",
    "openid",
    "multi-tenant",
    "workspaces",
    "feature-flags",
    "openfeature",
    "ofrep",
    "billing",
    "subscriptions",
    "usage-metering",
    "jwt",
    "revocation",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/thebridgedev/auth-core/issues"
  },
  "sideEffects": [
    "./dist/index.js"
  ]
}
